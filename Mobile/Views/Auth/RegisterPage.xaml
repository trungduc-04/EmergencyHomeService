<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="EmergencyHomeServiceMobile.Views.Auth.RegisterPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="Đăng ký">

    <ScrollView>

        <VerticalStackLayout
            Padding="25"
            Spacing="15">

            <Label
                Text="Tạo tài khoản"
                FontSize="28"
                FontAttributes="Bold" />

            <Entry
                x:Name="FullNameEntry"
                Placeholder="Họ và tên" />

            <Entry
                x:Name="EmailEntry"
                Placeholder="Email"
                Keyboard="Email" />

            <Entry
                x:Name="PhoneEntry"
                Placeholder="Số điện thoại"
                Keyboard="Telephone" />

            <Entry
                x:Name="PasswordEntry"
                Placeholder="Mật khẩu"
                IsPassword="True" 
                Keyboard="Default" />
            <Label
                Text="Mật khẩu: tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, số và ký tự đặc biệt."
                FontSize="12"
                TextColor="Gray" />

            <Label
                Text="Vai trò"
                FontAttributes="Bold" />

            <Picker
                x:Name="RolePicker"
                Title="Chọn vai trò">

                <Picker.Items>
                    <x:String>CUSTOMER</x:String>
                    <x:String>WORKER</x:String>
                </Picker.Items>

            </Picker>

            <Button
                x:Name="RegisterButton"
                Text="ĐĂNG KÝ"
                Clicked="RegisterButton_Clicked" />

            <ActivityIndicator
                x:Name="LoadingIndicator"
                IsVisible="False"
                IsRunning="False" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>